# Sabonner 运行器设置（bash 格式）。init.sh 选了本机运行器时会复制成仓库根目录的 .sabonner-runner.env；
# 改完执行 systemctl restart sabonner-runner 生效。bot token、Cloudflare token 等沿用 .sabonner.env，这里不用再写。

# 所有请求（bo3、斗鱼、Telegram、D1）都走这个代理；留空就直连。支持 socks5://用户名:密码@主机:端口
RUNNER_PROXY=
# bo3 / 斗鱼直连被拦截时改走 Worker 中转（1 开 / 0 关）
RUNNER_RELAY=1
# 直播轮询（顺带赛前提醒、日报、发消息）间隔，秒，30–300
RUNNER_LIVE_EVERY=60
# 斗鱼开播检查间隔，分钟
RUNNER_DOUYU_EVERY=2
# 赛程刷新间隔，分钟
RUNNER_REFRESH_EVERY=10
# 赛后数据检查间隔，分钟
RUNNER_STATS_EVERY=15
# 默认用 .sabonner.env 里的 SAVED_CF_TOKEN 读写 D1。想给运行器单独一个权限更小的 token（只要 Account · D1 · Edit），填在这里
RUNNER_CF_TOKEN=
# token 能访问多个 Cloudflare 账户时填账户 id
RUNNER_CF_ACCOUNT=
